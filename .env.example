# MAPL Tours — environment template.
#
# Copy this file to `.env.local` for development (gitignored) and set the
# real values on Netlify (Site settings → Environment variables) for prod.
#
# Anything prefixed with NEXT_PUBLIC_ is exposed to the browser. Keep
# secrets out of those — they end up in the client bundle.

# ── Supabase ──────────────────────────────────────────────────────────
# Public project URL + anonymous key. Used by the client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only service role key. Bypasses RLS — NEVER expose to the browser.
# Used by /api/checkout, /api/transfers/checkout, /api/webhooks/stripe,
# and any cron / admin route that needs to read or write across users.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ────────────────────────────────────────────────────────────
# Use test keys in dev (sk_test_..., pk_test_...) and live keys in prod.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret from Stripe dashboard → Developers → Webhooks →
# your endpoint. Without this the Stripe webhook returns 500 and bookings
# stay 'pending' forever.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (transactional email) ─────────────────────────────────────
RESEND_API_KEY=re_...

# Default sender. Format: "Display Name <inbox@domain>"
# If unset, falls back to "MAPL Tours <contact@mapltours.com>".
EMAIL_FROM=MAPL Tours <contact@mapltours.com>

# Default reply-to (used as the email-footer support link too).
# If unset, falls back to contact@mapltours.com.
EMAIL_SUPPORT=contact@mapltours.com

# Comma-separated list of recipients that get every booking + transfer
# alert from the Stripe webhook. If unset, the code falls back to
# contact@mapltours.com. Set this in the deploy environment as well: an
# OPERATIONS_EMAIL left over from an earlier value overrides the fallback,
# so changing the default in code alone does not move where alerts land.
OPERATIONS_EMAIL=contact@mapltours.com

# ── Scheduled jobs ────────────────────────────────────────────────────
# Shared secret the three Netlify scheduled functions present when they
# call their own endpoints: netlify/functions/dayof-cron.mjs (hourly),
# abandoned-cart-cron.mjs (hourly) and review-request-cron.mjs (daily at
# 14:00 UTC). Every one of those endpoints fails closed when it is unset,
# so a deploy without it does not error, it just silently stops sending:
# no day-of driver details, no abandoned-cart recovery, no review
# requests. Nothing tells you. Set it in the deploy environment, and use
# a long random value, since it is the only thing standing between the
# open internet and a job that sends mail.
#
#   openssl rand -hex 32
CRON_SECRET=

# Shared secret for the two Supabase database webhooks that call back into
# the app: /api/hooks/reward-unlocked and /api/hooks/video-status. Both
# compare the incoming header against this and answer 401 on a mismatch,
# so an unset value rejects every call rather than accepting any.
SUPABASE_WEBHOOK_SECRET=

# ── Driver portal ─────────────────────────────────────────────────────
# Comma-separated emails allowed to sign in to /driver. An empty value is
# an empty allowlist, which locks every driver out rather than letting
# everyone in, so this is required for the portal to work at all.
DRIVER_ALLOWED_EMAILS=collinsadventuretours@gmail.com

# Which single driver is BCCed on day-of dispatch mail. With more than one
# address on the allowlist and this unset, lib/email/send.ts cannot tell
# which driver a booking belongs to and deliberately BCCs NOBODY rather
# than mailing the wrong one, logging a warning instead. Set it whenever
# the allowlist has more than one entry.
DRIVER_NOTIFY_EMAIL=collinsadventuretours@gmail.com

# ── Flight tracking ───────────────────────────────────────────────────
# AeroDataBox, used by lib/flightProvider.ts to resolve a guest's flight
# number to scheduled and revised times so the driver is at the terminal
# when the plane actually lands. Absence is handled: FlightStatus comes
# back with configured:false and the dispatch console shows the times the
# guest typed instead of live ones. Nothing breaks, the tracking just
# stops being live.
AERODATABOX_API_KEY=

# ── Google Places (real ratings + photos for the food/culture rails) ──
# Server-only. Never prefix NEXT_PUBLIC_: photos are proxied through
# /api/places/photo precisely so this key stays off the client.
#
# Enable "Places API (New)" in Google Cloud, then restrict the key to that
# API. Without this the homepage still renders — cards fall back to licensed
# placeholder images and show no rating.
GOOGLE_PLACES_API_KEY=

# ── Site ──────────────────────────────────────────────────────────────
# Canonical URL of the deployed site. Used for canonical tags, the
# sitemap, and the OG image base URL. Always include the scheme; no
# trailing slash.
NEXT_PUBLIC_SITE_URL=https://mapltours.com
